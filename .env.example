# -----------------------------------------------------------------------------
# bAI — انسخ هذا الملف إلى .env.local واملأ القيم
# cp .env.example .env.local
# -----------------------------------------------------------------------------

# رابط التطبيق العام (محلياً أو على Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# اختياري: بعض مشاريع Supabase تستخدم الاسم الجديد للمفتاح العام
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI — لاستخراج بيانات الفاتورة (يُستخدم على الخادم فقط، لا تعرضه للمتصفح)
OPENAI_API_KEY=sk-your-openai-key

# لا تضع SUPABASE_SERVICE_ROLE_KEY في الواجهة الأمامية.
# التطبيق يعتمد على جلسة المستخدم + RLS بدل service role.
